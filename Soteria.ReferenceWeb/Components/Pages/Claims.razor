@page "/claims"

@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.JSInterop
@using Soteria.ReferenceWeb.Components.Reference

@attribute [Authorize(Policy = "DevelopmentClaims")]

@implements IAsyncDisposable

@inject IJSRuntime JsRuntime
@inject NavigationManager NavigationManager

<PageTitle>Claims</PageTitle>

<h1>Claims</h1>

<div class="alert alert-warning" role="status">
    This diagnostic page is available only in the Development
    environment.
</div>

<AuthorizeView Context="authorizationContext">
    <Authorized>
        @{
            var user = authorizationContext.User;

            var roleClaimType =
                user.Identities
                    .FirstOrDefault()?
                    .RoleClaimType;

            var roleClaims = user.Claims
                .Where(claim =>
                    claim.Type == roleClaimType)
                .OrderBy(claim => claim.Value)
                .ToArray();

            var remainingClaims = user.Claims
                .Where(claim =>
                    claim.Type != roleClaimType)
                .OrderBy(claim => claim.Type)
                .ThenBy(claim => claim.Value)
                .ToArray();
        }

        <section class="mb-5">
            <h2>Reference Web principal</h2>

            <p>
                These claims were reconstructed from the Reference Web
                authentication session.
            </p>

            <section class="mb-4">
                <h3 class="h4">Authenticated user</h3>

                <dl class="row">
                    <dt class="col-sm-3">Name</dt>
                    <dd class="col-sm-9">
                        @DisplayValue(user.Identity?.Name)
                    </dd>

                    <dt class="col-sm-3">Subject</dt>
                    <dd class="col-sm-9">
                        @DisplayClaimValue(user, "sub")
                    </dd>

                    <dt class="col-sm-3">Username</dt>
                    <dd class="col-sm-9">
                        @DisplayClaimValue(
                            user,
                            "preferred_username")
                    </dd>

                    <dt class="col-sm-3">Email</dt>
                    <dd class="col-sm-9">
                        @DisplayClaimValue(user, "email")
                    </dd>

                    <dt class="col-sm-3">
                        Authentication type
                    </dt>
                    <dd class="col-sm-9">
                        @DisplayValue(
                            user.Identity?
                                .AuthenticationType)
                    </dd>

                    <dt class="col-sm-3">
                        Role claim type
                    </dt>
                    <dd class="col-sm-9">
                        @DisplayValue(roleClaimType)
                    </dd>
                </dl>
            </section>

            <section class="mb-4">
                <h3 class="h4">Application Roles</h3>

                @if (roleClaims.Length == 0)
                {
                    <p>
                        No Application Role claims were issued.
                    </p>
                }
                else
                {
                    <ul>
                        @foreach (var roleClaim in roleClaims)
                        {
                            <li>@roleClaim.Value</li>
                        }
                    </ul>
                }
            </section>

            <section>
                <h3 class="h4">All remaining claims</h3>

                @if (remainingClaims.Length == 0)
                {
                    <p>No additional claims were issued.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-striped table-bordered">
                            <thead>
                                <tr>
                                    <th scope="col">Type</th>
                                    <th scope="col">Value</th>
                                    <th scope="col">Value type</th>
                                    <th scope="col">Issuer</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (
                                    var claim in remainingClaims)
                                {
                                    <tr>
                                        <td>
                                            <code>@claim.Type</code>
                                        </td>
                                        <td class="text-break">
                                            @claim.Value
                                        </td>
                                        <td>
                                            <code>
                                                @claim.ValueType
                                            </code>
                                        </td>
                                        <td class="text-break">
                                            @claim.Issuer
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>
        </section>

        <hr />

        <section class="mt-5">
            <h2>Reference API principal</h2>

            <p>
                These claims were reconstructed by Reference API from
                the access token.
            </p>

            <button class="btn btn-primary"
                    disabled="@isLoadingApiClaims"
                    @onclick="LoadApiClaimsAsync">
                @(isLoadingApiClaims
                    ? "Loading API claims..."
                    : "Load API claims")
            </button>

            @if (!string.IsNullOrWhiteSpace(apiErrorMessage))
            {
                <div class="alert alert-danger mt-3"
                     role="alert">
                    @apiErrorMessage
                </div>
            }

            @if (apiClaims is not null)
            {
                <section class="mt-4 mb-4">
                    <h3 class="h4">Authenticated user</h3>

                    <dl class="row">
                        <dt class="col-sm-3">Name</dt>
                        <dd class="col-sm-9">
                            @DisplayValue(apiClaims.Name)
                        </dd>

                        <dt class="col-sm-3">Subject</dt>
                        <dd class="col-sm-9">
                            @DisplayValue(apiClaims.Subject)
                        </dd>

                        <dt class="col-sm-3">Username</dt>
                        <dd class="col-sm-9">
                            @DisplayValue(apiClaims.Username)
                        </dd>

                        <dt class="col-sm-3">Email</dt>
                        <dd class="col-sm-9">
                            @DisplayValue(apiClaims.Email)
                        </dd>

                        <dt class="col-sm-3">
                            Authentication type
                        </dt>
                        <dd class="col-sm-9">
                            @DisplayValue(
                                apiClaims.AuthenticationType)
                        </dd>

                        <dt class="col-sm-3">
                            Role claim type
                        </dt>
                        <dd class="col-sm-9">
                            @DisplayValue(
                                apiClaims.RoleClaimType)
                        </dd>
                    </dl>
                </section>

                <section class="mb-4">
                    <h3 class="h4">Application Roles</h3>

                    @if (apiClaims.Roles.Count == 0)
                    {
                        <p>
                            No Application Role claims were issued.
                        </p>
                    }
                    else
                    {
                        <ul>
                            @foreach (var role in apiClaims.Roles)
                            {
                                <li>@role</li>
                            }
                        </ul>
                    }
                </section>

                <section>
                    <h3 class="h4">All remaining claims</h3>

                    @if (apiClaims.Claims.Count == 0)
                    {
                        <p>No additional claims were issued.</p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-bordered">
                                <thead>
                                    <tr>
                                        <th scope="col">Type</th>
                                        <th scope="col">Value</th>
                                        <th scope="col">
                                            Value type
                                        </th>
                                        <th scope="col">Issuer</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (
                                        var claim in apiClaims.Claims)
                                    {
                                        <tr>
                                            <td>
                                                <code>
                                                    @claim.Type
                                                </code>
                                            </td>
                                            <td class="text-break">
                                                @claim.Value
                                            </td>
                                            <td>
                                                <code>
                                                    @claim.ValueType
                                                </code>
                                            </td>
                                            <td class="text-break">
                                                @claim.Issuer
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </section>
            }
        </section>
    </Authorized>
</AuthorizeView>

@code {
    private const string EmptyValue = "Not issued";

    private IJSObjectReference? module;
    private bool isLoadingApiClaims;
    private string? apiErrorMessage;
    private ReferenceClaimsResponse? apiClaims;

    private async Task LoadApiClaimsAsync()
    {
        isLoadingApiClaims = true;
        apiErrorMessage = null;
        apiClaims = null;

        try
        {
            module ??=
                await JsRuntime.InvokeAsync<IJSObjectReference>(
                    "import",
                    "./js/reference-api.js");

            var result =
                await module.InvokeAsync<
                    ReferenceApiResult<
                        ReferenceClaimsResponse>>(
                    "callReferenceApi",
                    "claims");

            if (result.Status ==
                StatusCodes.Status401Unauthorized)
            {
                NavigationManager.NavigateTo(
                    "/Account/Login?returnUrl=/claims",
                    forceLoad: true);

                return;
            }

            if (!result.Ok)
            {
                apiErrorMessage =
                    result.Message
                    ?? $"The Reference API request failed with " +
                    $"status {result.Status}.";

                return;
            }

            apiClaims = result.Data;

            if (apiClaims is null)
            {
                apiErrorMessage =
                    "The Reference API returned an empty " +
                    "claims response.";
            }
        }
        catch (JSException exception)
        {
            apiErrorMessage =
                $"The Reference API request could not be " +
                $"completed: {exception.Message}";
        }
        finally
        {
            isLoadingApiClaims = false;
        }
    }

    private static string DisplayClaimValue(
        ClaimsPrincipal user,
        string claimType)
    {
        return DisplayValue(
            user.FindFirst(claimType)?.Value);
    }

    private static string DisplayValue(string? value)
    {
        return string.IsNullOrWhiteSpace(value)
            ? EmptyValue
            : value;
    }

    public async ValueTask DisposeAsync()
    {
        if (module is not null)
        {
            try
            {
                await module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The browser circuit has already disconnected.
            }
        }
    }
}
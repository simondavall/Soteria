@page "/claims"

@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization

@attribute [Authorize(Policy = "DevelopmentClaims")]

<PageTitle>Claims</PageTitle>

<h1>Claims</h1>

<AuthorizeView Context="authorizationContext">
    <Authorized>
        @{
            var user = authorizationContext.User;

            var roleClaims = user.Claims
                .Where(claim =>
                    claim.Type == user.Identities
                        .FirstOrDefault()?
                        .RoleClaimType)
                .OrderBy(claim => claim.Value)
                .ToArray();

            var remainingClaims = user.Claims
                .Where(claim =>
                    claim.Type != user.Identities
                        .FirstOrDefault()?
                        .RoleClaimType)
                .OrderBy(claim => claim.Type)
                .ThenBy(claim => claim.Value)
                .ToArray();
        }

        <div class="alert alert-warning" role="status">
            This diagnostic page is available only in the Development
            environment.
        </div>

        <section class="mb-4">
            <h2 class="h4">Authenticated user</h2>

            <dl class="row">
                <dt class="col-sm-3">Name</dt>
                <dd class="col-sm-9">
                    @DisplayValue(user.Identity?.Name)
                </dd>

                <dt class="col-sm-3">Subject</dt>
                <dd class="col-sm-9">
                    @DisplayClaimValue(user, "sub")
                </dd>

                <dt class="col-sm-3">Username</dt>
                <dd class="col-sm-9">
                    @DisplayClaimValue(user, "preferred_username")
                </dd>

                <dt class="col-sm-3">Email</dt>
                <dd class="col-sm-9">
                    @DisplayClaimValue(user, "email")
                </dd>

                <dt class="col-sm-3">Authentication type</dt>
                <dd class="col-sm-9">
                    @DisplayValue(user.Identity?.AuthenticationType)
                </dd>

                <dt class="col-sm-3">Role claim type</dt>
                <dd class="col-sm-9">
                    @DisplayValue(
                        user.Identities
                            .FirstOrDefault()?
                            .RoleClaimType)
                </dd>
            </dl>
        </section>

        <section class="mb-4">
            <h2 class="h4">Application Roles</h2>

            @if (roleClaims.Length == 0)
            {
                <p>No Application Role claims were issued.</p>
            }
            else
            {
                <ul>
                    @foreach (var roleClaim in roleClaims)
                    {
                        <li>@roleClaim.Value</li>
                    }
                </ul>
            }
        </section>

        <section>
            <h2 class="h4">All remaining claims</h2>

            @if (remainingClaims.Length == 0)
            {
                <p>No additional claims were issued.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-bordered">
                        <thead>
                            <tr>
                                <th scope="col">Type</th>
                                <th scope="col">Value</th>
                                <th scope="col">Value type</th>
                                <th scope="col">Issuer</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var claim in remainingClaims)
                            {
                                <tr>
                                    <td><code>@claim.Type</code></td>
                                    <td class="text-break">@claim.Value</td>
                                    <td><code>@claim.ValueType</code></td>
                                    <td class="text-break">@claim.Issuer</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    </Authorized>
</AuthorizeView>

@code {
    private const string EmptyValue = "Not issued";

    private static string DisplayClaimValue(
        ClaimsPrincipal user,
        string claimType)
    {
        return DisplayValue(
            user.FindFirst(claimType)?.Value);
    }

    private static string DisplayValue(string? value)
    {
        return string.IsNullOrWhiteSpace(value)
            ? EmptyValue
            : value;
    }
}
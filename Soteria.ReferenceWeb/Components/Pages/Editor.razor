@page "/editor"

@using Microsoft.AspNetCore.Authorization

@attribute [Authorize(Policy = "Editor")]

<PageTitle>Editor</PageTitle>

<h1>Editor</h1>

<div class="alert alert-success" role="status">
    <h2 class="h4">Editor policy satisfied</h2>

    <p class="mb-0">
        You can access this page because the authenticated user has the
        <strong>Editor</strong> Application Role.
    </p>
</div>

<AuthorizeView>
    <Authorized>
        <p>
            Authenticated user:
            <strong>@context.User.Identity?.Name</strong>
        </p>
    </Authorized>
</AuthorizeView>
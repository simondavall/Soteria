@page "/Account/Manage/SetPassword"

<PageTitle>Set password</PageTitle>

<MudText Typo="Typo.h5"
         GutterBottom="true">
    Set your password
</MudText>

<StatusMessage Message="@_message"/>

<MudAlert Severity="Severity.Info"
          Variant="Variant.Outlined"
          Class="mb-4">
    You do not have a local username and password for this site.
    Add a local password so you can log in without an external provider.
</MudAlert>

<MudGrid>
    <MudItem xs="12"
             md="7">
        <EditForm Model="Input"
                  FormName="set-password"
                  OnValidSubmit="OnValidSubmitAsync"
                  method="post"
                  novalidate>
            <DataAnnotationsValidator/>

            <MudStack Spacing="3">
                <div class="account-field"
                     data-validation-field>
                    <label for="new-password">
                        New password
                    </label>

                    <InputText id="new-password"
                               class="account-input"
                               type="password"
                               @bind-Value="Input.NewPassword"
                               autocomplete="new-password"
                               aria-required="true"
                               placeholder="New password"/>

                    <ValidationMessage For="@(() => Input.NewPassword)"/>
                </div>

                <div class="account-field"
                     data-validation-field>
                    <label for="confirm-password">
                        Confirm new password
                    </label>

                    <InputText id="confirm-password"
                               class="account-input"
                               type="password"
                               @bind-Value="Input.ConfirmPassword"
                               autocomplete="new-password"
                               aria-required="true"
                               placeholder="Confirm new password"/>

                    <ValidationMessage For="@(() => Input.ConfirmPassword)"/>
                </div>

                <MudButton ButtonType="ButtonType.Submit"
                           Variant="Variant.Filled"
                           Color="Color.Primary">
                    Set password
                </MudButton>
            </MudStack>
        </EditForm>
    </MudItem>
</MudGrid>
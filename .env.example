# Development-only configuration.
# Copy this file to .env and provide local values.
# Never commit the populated .env file.

# Secret used by the Development reference OpenID Connect client.
Authentication__OpenIdConnect__ClientSecret=

# Base64-encoded symmetric key used for Development token encryption.
# Must contain at least 32 bytes of decoded key material.
OpenIddict__EncryptionKey=

# Optional bootstrap administrator email.
# When omitted and no Soteria Administrator exists, the first registered
# user becomes the Soteria Administrator.
Bootstrap__SoteriaAdministratorEmail=
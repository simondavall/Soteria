# Development-only configuration.
# Copy this file to .env and provide local values.
# Never commit the populated .env file.

# Secret used by the Development reference OpenID Connect client.
Authentication__OpenIdConnect__ClientSecret=

# Base64-encoded symmetric key used for Development token encryption.
# Must contain at least 32 bytes of decoded key material.
OpenIddict__EncryptionKey=

# Optional bootstrap administrator email.
# When omitted and no Soteria Administrator exists, the first registered
# user becomes the Soteria Administrator.
Bootstrap__SoteriaAdministratorEmail=

# SMTP configuration used to deliver Soteria Identity emails.
# Use SslOnConnect for implicit TLS, normally on port 465.
# Use StartTls for explicit TLS, normally on port 587.
Soteria__Email__Host=
Soteria__Email__Port=465
Soteria__Email__Security=SslOnConnect
Soteria__Email__DisplayName=Soteria
Soteria__Email__SenderAddress=
Soteria__Email__Username=
Soteria__Email__Password=

# Production Data Protection configuration.
# Configure these as environment variables on the Production host.
# Explicit Soteria Data Protection configuration is not used in Development.
DataProtection__KeysPath=
DataProtection__CertificatePath=
DataProtection__CertificatePassword=

Serilog__WriteTo__Sink__Args__path=<log path>
ConnectionStrings__SoteriaDb=Data Source=<db path>
{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": {
      "Sink": {
        "Name": "Console"
      }
    },
    "Enrich": [
      "FromLogContext"
    ]
  },
  "OpenIddict": {
    "Tokens": {
      "AccessTokenLifetimeMinutes": 2,
      "RefreshTokenLifetimeDays": 14
    }
  }
}

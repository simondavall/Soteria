@page "/Account/Logout"

<PageTitle>Logging out</PageTitle>

<MudText>Logging out...</MudText>

<form id="logout-form"
      action="/Account/Logout"
      method="post">

    <AntiforgeryToken />

    <input type="hidden"
           name="ReturnUrl"
           value="" />
</form>

<script>
    document.getElementById("logout-form").submit();
</script>
@page "/Account/Manage/ChangePassword"

<PageTitle>Change password</PageTitle>

<MudText Typo="Typo.h5"
         GutterBottom="true">
    Change password
</MudText>

<StatusMessage Message="@_message"/>

<MudGrid>
    <MudItem xs="12"
             md="7">
        <EditForm Model="Input"
                  FormName="change-password"
                  OnValidSubmit="OnValidSubmitAsync"
                  method="post"
                  novalidate>
            <DataAnnotationsValidator/>

            <MudStack Spacing="3">
                <div class="account-field"
                     data-validation-field>
                    <label for="old-password">
                        Current password
                    </label>

                    <InputText id="old-password"
                               class="account-input"
                               type="password"
                               @bind-Value="Input.OldPassword"
                               autocomplete="current-password"
                               aria-required="true"
                               placeholder="Current password"/>

                    <ValidationMessage For="@(() => Input.OldPassword)"/>
                </div>

                <div class="account-field"
                     data-validation-field>
                    <label for="new-password">
                        New password
                    </label>

                    <InputText id="new-password"
                               class="account-input"
                               type="password"
                               @bind-Value="Input.NewPassword"
                               autocomplete="new-password"
                               aria-required="true"
                               placeholder="New password"/>

                    <ValidationMessage For="@(() => Input.NewPassword)"/>
                </div>

                <div class="account-field"
                     data-validation-field>
                    <label for="confirm-password">
                        Confirm new password
                    </label>

                    <InputText id="confirm-password"
                               class="account-input"
                               type="password"
                               @bind-Value="Input.ConfirmPassword"
                               autocomplete="new-password"
                               aria-required="true"
                               placeholder="Confirm new password"/>

                    <ValidationMessage For="@(() => Input.ConfirmPassword)"/>
                </div>

                <MudButton ButtonType="ButtonType.Submit"
                           Variant="Variant.Filled"
                           Color="Color.Primary">
                    Update password
                </MudButton>
            </MudStack>
        </EditForm>
    </MudItem>
</MudGrid>
@using Soteria.Components.Features.Authorization

<MudNavMenu Class="pa-2">
    <AuthorizeView>
        <Authorized Context="authContext">
            <AuthorizeView Policy="@SoteriaAuthorizationPolicies.Administration">
                <Authorized>
                    <MudNavLink Href="clients"
                                Match="NavLinkMatch.Prefix"
                                Icon="@Icons.Material.Filled.Apps">
                        Client Applications
                    </MudNavLink>

                    <MudNavLink Href="users"
                                Match="NavLinkMatch.Prefix"
                                Icon="@Icons.Material.Filled.People">
                        Users
                    </MudNavLink>

                    <MudDivider Class="my-2" />
                </Authorized>
            </AuthorizeView>

            <MudNavLink Href="/Account/Manage"
                        Match="NavLinkMatch.Prefix"
                        Icon="@Icons.Material.Filled.Person">
                @authContext.User.Identity?.Name
            </MudNavLink>

            <MudNavLink Href="/Account/Logout"
                        Match="NavLinkMatch.Prefix"
                        Icon="@Icons.Material.Filled.Logout">
                Log out
            </MudNavLink>
        </Authorized>

        <NotAuthorized>
            @if (BootstrapRegistrationRequired)
            {
                <MudNavLink Href="/Account/Register"
                            Match="NavLinkMatch.Prefix"
                            Icon="@Icons.Material.Filled.PersonAdd">
                    Register Soteria Admin
                </MudNavLink>
            }

            <MudNavLink Href="/Account/Login"
                        Match="NavLinkMatch.Prefix"
                        Icon="@Icons.Material.Filled.Login">
                Log in
            </MudNavLink>
        </NotAuthorized>
    </AuthorizeView>
</MudNavMenu>
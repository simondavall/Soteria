<MudNavMenu Class="pa-2">
    <MudNavLink Href="/"
                Match="NavLinkMatch.All"
                Icon="@Icons.Material.Filled.Home">
        Home
    </MudNavLink>

    <MudNavLink Href="/counter"
                Match="NavLinkMatch.Prefix"
                Icon="@Icons.Material.Filled.AddBox">
        Counter
    </MudNavLink>

    <MudNavLink Href="/weather"
                Match="NavLinkMatch.Prefix"
                Icon="@Icons.Material.Filled.List">
        Weather
    </MudNavLink>

    <MudNavLink Href="/auth"
                Match="NavLinkMatch.Prefix"
                Icon="@Icons.Material.Filled.Lock">
        Auth Required
    </MudNavLink>

    <AuthorizeView>
        <Authorized Context="authContext">
            <MudDivider Class="my-2"/>

            <MudText Typo="Typo.overline"
                     Color="Color.Secondary"
                     Class="px-4 pt-2 pb-1">
                Administration
            </MudText>

            <MudNavLink Href="/clients"
                        Match="NavLinkMatch.Prefix"
                        Icon="@Icons.Material.Filled.Apps">
                Client Applications
            </MudNavLink>

            <MudNavLink Href="/users"
                        Match="NavLinkMatch.Prefix"
                        Icon="@Icons.Material.Filled.ManageAccounts">
                Users
            </MudNavLink>
            
            <MudDivider Class="my-2"/>

            <MudNavLink Href="/Account/Manage"
                        Match="NavLinkMatch.Prefix"
                        Icon="@Icons.Material.Filled.Person">
                @authContext.User.Identity?.Name
            </MudNavLink>

            <form action="/Account/Logout" method="post">
                <AntiforgeryToken/>
                <input type="hidden"
                       name="ReturnUrl"
                       value="@CurrentRelativeUrl"/>

                <MudButton ButtonType="ButtonType.Submit"
                           Variant="Variant.Text"
                           Color="Color.Inherit"
                           StartIcon="@Icons.Material.Filled.Logout"
                           FullWidth="true"
                           Class="justify-start">
                    Log out
                </MudButton>
            </form>
        </Authorized>

        <NotAuthorized>
            <MudDivider Class="my-2"/>

            @if (BootstrapRegistrationRequired)
            {
                <MudNavLink Href="/Account/Register"
                            Match="NavLinkMatch.Prefix"
                            Icon="@Icons.Material.Filled.PersonAdd">
                    Register Soteria Admin
                </MudNavLink>
            }

            <MudNavLink Href="/Account/Login"
                        Match="NavLinkMatch.Prefix"
                        Icon="@Icons.Material.Filled.Login">
                Log in
            </MudNavLink>
        </NotAuthorized>
    </AuthorizeView>
</MudNavMenu>
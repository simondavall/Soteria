@using Soteria.Components.Features.Clients.Queries
@using Soteria.Data.Authorization

<MudDialog>
    <DialogContent>
        <MudForm @ref="Form">
            <MudStack Spacing="3">
                @if (ErrorMessages.Count > 0)
                {
                    <MudAlert Severity="Severity.Error"
                              Variant="Variant.Outlined">
                        <MudList T="string"
                                 Dense="true"
                                 Class="pa-0">
                            @foreach (var message in ErrorMessages)
                            {
                                <MudListItem T="string">
                                    @message
                                </MudListItem>
                            }
                        </MudList>
                    </MudAlert>
                }

                @if (IsLoading)
                {
                    <div class="d-flex justify-center pa-4">
                        <MudProgressCircular Indeterminate="true"/>
                    </div>
                }
                else if (AvailableClients.Count == 0)
                {
                    <MudAlert Severity="Severity.Info"
                              Variant="Variant.Outlined">
                        This user already belongs to every available client application.
                    </MudAlert>
                }
                else
                {
                    <MudSelect T="string"
                               Label="Client application"
                               Variant="Variant.Outlined"
                               Required="true"
                               RequiredError="Select a client application."
                               @bind-Value="Request.ClientId"
                               For="@(() => Request.ClientId)"
                               Validation="@CreateClientMembershipValidator.ValidateValueAsync">

                        @foreach (var client in AvailableClients)
                        {
                            <MudSelectItem T="string"
                                           Value="@client.ClientId">
                                @client.DisplayName
                            </MudSelectItem>
                        }
                    </MudSelect>

                    <MudSelect T="MembershipLevel"
                               Label="Membership level"
                               Variant="Variant.Outlined"
                               Required="true"
                               @bind-Value="Request.MembershipLevel"
                               For="@(() => Request.MembershipLevel)"
                               Validation="@CreateClientMembershipValidator.ValidateValueAsync">

                        @foreach (var membershipLevel in MembershipLevels)
                        {
                            <MudSelectItem T="MembershipLevel"
                                           Value="@membershipLevel">
                                @membershipLevel
                            </MudSelectItem>
                        }
                    </MudSelect>
                }
            </MudStack>
        </MudForm>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancel"
                   Disabled="@IsSaving">
            Cancel
        </MudButton>

        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   OnClick="SaveAsync"
                   Disabled="@(IsLoading || IsSaving || AvailableClients.Count == 0)">
            @if (IsSaving)
            {
                <MudProgressCircular Size="Size.Small"
                                     Indeterminate="true"
                                     Class="mr-2"/>
            }

            Assign
        </MudButton>
    </DialogActions>
</MudDialog>
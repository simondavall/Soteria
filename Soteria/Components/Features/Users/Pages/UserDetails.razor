@page "/users/{UserId:guid}"

@using Microsoft.AspNetCore.Authorization
@using Soteria.Components.Features.Authorization
@using Soteria.Components.Features.ClientMemberships

@attribute [Authorize(Policy = SoteriaAuthorizationPolicies.Administration)]

<PageTitle>User Details</PageTitle>

<div class="user-details-page">
    <MudStack Spacing="4">
        <header class="user-details-page__header">
            <MudStack Row="true"
                      AlignItems="AlignItems.Center"
                      Justify="Justify.SpaceBetween"
                      Spacing="3"
                      Class="user-details-page__header-content">

                <MudStack Row="true"
                          AlignItems="AlignItems.Center"
                          Spacing="2">

                    <MudAvatar Color="Color.Primary"
                               Variant="Variant.Filled"
                               Size="Size.Large">
                        <MudIcon Icon="@Icons.Material.Filled.Person"/>
                    </MudAvatar>

                    <MudText Typo="Typo.h4"
                             HtmlTag="h1">
                        User Details
                    </MudText>

                </MudStack>

                <MudStack Row="true"
                          Spacing="2">

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Edit"
                               OnClick="@EditUserAsync">
                        Edit
                    </MudButton>

                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.ArrowBack"
                               OnClick="@ReturnToUserList">
                        Back to users
                    </MudButton>
                </MudStack>
            </MudStack>
        </header>

        @if (IsLoading)
        {
            <MudPaper Class="user-details-page__content"
                      Elevation="1">

                <div class="user-details-page__state">
                    <MudProgressCircular Indeterminate="true"
                                         Color="Color.Primary"/>

                    <MudText Typo="Typo.body1"
                             Color="Color.Secondary">
                        Loading user details...
                    </MudText>
                </div>
            </MudPaper>
        }
        else if (User is null)
        {
            <MudPaper Class="user-details-page__content"
                      Elevation="1">

                <div class="user-details-page__state">
                    <MudIcon Icon="@Icons.Material.Filled.PersonOff"
                             Size="Size.Large"
                             Color="Color.Secondary"/>

                    <MudText Typo="Typo.h5"
                             HtmlTag="h2">
                        User not found
                    </MudText>

                    <MudText Typo="Typo.body1"
                             Color="Color.Secondary"
                             Align="Align.Center">
                        The requested user does not exist or is no longer available.
                    </MudText>

                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.ArrowBack"
                               OnClick="@ReturnToUserList">
                        Back to users
                    </MudButton>
                </div>
            </MudPaper>
        }
        else
        {
            <MudStack Spacing="4">
                <MudPaper Class="p-2 user-details-page__content"
                          Elevation="1">

                    <MudStack Spacing="3">
                        <MudStack Row="true"
                                  AlignItems="AlignItems.Center"
                                  Spacing="2">

                            <MudText Typo="Typo.h6"
                                     HtmlTag="h2">
                                User Details
                            </MudText>

                            @if (User.IsSoteriaAdministrator)
                            {
                                <MudChip T="string"
                                         Size="Size.Small"
                                         Color="Color.Primary"
                                         Variant="Variant.Filled"
                                         Icon="@Icons.Material.Filled.AdminPanelSettings">
                                    Soteria Admin
                                </MudChip>
                            }
                        </MudStack>

                        <div class="user-details-page__columns">
                            <div class="user-details-page__column">
                                <div class="user-details-page__field">
                                    <MudText Typo="Typo.overline"
                                             Color="Color.Secondary">
                                        Username
                                    </MudText>

                                    <MudText Typo="Typo.body1">
                                        @User.UserName
                                    </MudText>
                                </div>

                                <div class="user-details-page__field">
                                    <MudText Typo="Typo.overline"
                                             Color="Color.Secondary">
                                        Display Name
                                    </MudText>

                                    <MudText Typo="Typo.body1">
                                        @User.DisplayName
                                    </MudText>
                                </div>
                            </div>

                            <div class="user-details-page__column">
                                <div class="user-details-page__field">
                                    <MudText Typo="Typo.overline"
                                             Color="Color.Secondary">
                                        User ID
                                    </MudText>

                                    <MudText Typo="Typo.body1">
                                        @User.UserId
                                    </MudText>
                                </div>

                                <div class="user-details-page__field">
                                    <MudText Typo="Typo.overline"
                                             Color="Color.Secondary">
                                        Email
                                    </MudText>

                                    <MudText Typo="Typo.body1">
                                        @User.Email
                                    </MudText>
                                </div>
                            </div>
                        </div>

                        <div class="user-details-page__status-row">
                            <div class="user-details-page__status">
                                <MudText Typo="Typo.overline"
                                         Color="Color.Secondary">
                                    Email Confirmed
                                </MudText>

                                <MudChip T="bool"
                                         Color="@(User.EmailConfirmed ? Color.Success : Color.Warning)"
                                         Variant="Variant.Filled"
                                         Size="Size.Small">
                                    @User.EmailConfirmed
                                </MudChip>
                            </div>

                            <div class="user-details-page__status">
                                <MudText Typo="Typo.overline"
                                         Color="Color.Secondary">
                                    Locked Out
                                </MudText>

                                <MudChip T="bool"
                                         Color="@(User.IsLockedOut ? Color.Error : Color.Success)"
                                         Variant="Variant.Filled"
                                         Size="Size.Small">
                                    @User.IsLockedOut
                                </MudChip>
                            </div>
                            @if (User.IsLockedOut)
                            {
                                <div class="user-details-page__status">
                                    <MudText Typo="Typo.overline"
                                             Color="Color.Secondary">
                                        Lockout End
                                    </MudText>

                                    <MudText Typo="Typo.body1">
                                        @FormatLockoutEnd(User.LockoutEnd)
                                    </MudText>
                                </div>
                            }

                        </div>
                    </MudStack>
                </MudPaper>

                <MudPaper Class="p-2 user-details-page__content"
                          Elevation="1">

                    <MudStack Spacing="3">
                        <MudStack Row="true"
                                  AlignItems="AlignItems.Center"
                                  Justify="Justify.SpaceBetween"
                                  Class="user-details-page__permissions-header">

                            <div>
                                <MudText Typo="Typo.h6"
                                         HtmlTag="h2">
                                    Permissions
                                </MudText>

                                <MudText Typo="Typo.body2"
                                         Color="Color.Secondary">
                                    Client application memberships and assigned application roles.
                                </MudText>
                            </div>

                            <MudButton Color="Color.Primary"
                                       Variant="Variant.Filled"
                                       StartIcon="@Icons.Material.Filled.Add"
                                       OnClick="@AssignClientAsync">
                                Assign Client
                            </MudButton>
                        </MudStack>

                        @if (ClientMemberships.Count == 0)
                        {
                            <div class="user-details-page__empty-permissions">
                                <MudIcon Icon="@Icons.Material.Filled.AdminPanelSettings"
                                         Size="Size.Large"
                                         Color="Color.Secondary"/>

                                <MudText Typo="Typo.body1"
                                         Align="Align.Center">
                                    No client memberships
                                </MudText>

                                <MudText Typo="Typo.body2"
                                         Color="Color.Secondary"
                                         Align="Align.Center">
                                    This user has not been granted access to any client applications.
                                </MudText>
                            </div>
                        }
                        else
                        {
                            <div class="user-details-page__table-container">
                                <MudTable T="ClientMembershipDetailsModel"
                                          Items="@ClientMemberships"
                                          Hover="true"
                                          Dense="true"
                                          Elevation="0"
                                          RowClass="user-details-page__membership-row"
                                          OnRowClick="@(args => EditClientMembershipAsync(args.Item!))"
                                          Class="user-details-page__permissions-table">

                                    <HeaderContent>
                                        <MudTh>Client Application</MudTh>
                                        <MudTh>Membership Level</MudTh>
                                        <MudTh>Application Roles</MudTh>
                                    </HeaderContent>

                                    <RowTemplate>
                                        <MudTd DataLabel="Client Application">
                                            <MudText Typo="Typo.body2">
                                                @context.ApplicationName
                                            </MudText>
                                        </MudTd>

                                        <MudTd DataLabel="Membership Level">
                                            <MudChip T="string"
                                                     Size="Size.Small"
                                                     Variant="Variant.Outlined"
                                                     Color="Color.Primary">
                                                @context.MembershipLevel
                                            </MudChip>
                                        </MudTd>

                                        <MudTd DataLabel="Application Roles">
                                            @if (context.ApplicationRoles.Count == 0)
                                            {
                                                <MudText Typo="Typo.body2"
                                                         Color="Color.Secondary">
                                                    None
                                                </MudText>
                                            }
                                            else
                                            {
                                                <div class="user-details-page__roles">
                                                    @foreach (var role in context.ApplicationRoles)
                                                    {
                                                        <MudChip T="string"
                                                                 Size="Size.Small"
                                                                 Variant="Variant.Filled">
                                                            @role
                                                        </MudChip>
                                                    }
                                                </div>
                                            }
                                        </MudTd>
                                    </RowTemplate>
                                </MudTable>
                            </div>
                        }
                    </MudStack>
                </MudPaper>
            </MudStack>
        }
    </MudStack>
</div>
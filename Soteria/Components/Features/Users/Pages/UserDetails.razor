@page "/users/{UserId:guid}"

@using Microsoft.AspNetCore.Authorization

@attribute [Authorize]

<PageTitle>User Details</PageTitle>

<div class="user-details-page">
    <MudStack Spacing="4">
        <header class="user-details-page__header">
            <MudStack Row="true"
                      AlignItems="AlignItems.Center"
                      Justify="Justify.SpaceBetween"
                      Spacing="3"
                      Class="user-details-page__header-content">

                <MudStack Row="true"
                          AlignItems="AlignItems.Center"
                          Spacing="2">

                    <MudAvatar Color="Color.Primary"
                               Variant="Variant.Filled"
                               Size="Size.Large">
                        <MudIcon Icon="@Icons.Material.Filled.Person"/>
                    </MudAvatar>

                    <MudStack Spacing="0">
                        <MudText Typo="Typo.h4"
                                 HtmlTag="h1">
                            User Details
                        </MudText>

                        <MudText Typo="Typo.body1"
                                 Color="Color.Secondary">
                            Review the selected user's personal information and permissions.
                        </MudText>
                    </MudStack>
                </MudStack>

                <MudStack Row="true"
                          Spacing="2">

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Edit"
                               Disabled="true">
                        Edit
                    </MudButton>

                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.ArrowBack"
                               OnClick="ReturnToUserList">
                        Back to users
                    </MudButton>
                </MudStack>
            </MudStack>
        </header>

        <MudStack Spacing="4">
            <MudPaper Class="user-details-page__content"
                      Elevation="1">

                <MudStack Spacing="3">
                    <MudText Typo="Typo.h6"
                             HtmlTag="h2">
                        Personal
                    </MudText>

                    <div class="user-details-page__personal-grid">
                        <div>
                            <MudText Typo="Typo.overline"
                                     Color="Color.Secondary">
                                User identifier
                            </MudText>

                            <MudText Typo="Typo.body1">
                                @UserId
                            </MudText>
                        </div>
                    </div>

                    <MudText Typo="Typo.body2"
                             Color="Color.Secondary">
                        Personal and account information will be displayed here.
                    </MudText>
                </MudStack>
            </MudPaper>

            <MudPaper Class="user-details-page__content"
                      Elevation="1">

                <MudStack Spacing="3">
                    <MudText Typo="Typo.h6"
                             HtmlTag="h2">
                        Permissions
                    </MudText>

                    <MudText Typo="Typo.body2"
                             Color="Color.Secondary">
                        Client assignments, roles and permissions will be displayed here.
                    </MudText>
                </MudStack>
            </MudPaper>
        </MudStack>
    </MudStack>
</div>
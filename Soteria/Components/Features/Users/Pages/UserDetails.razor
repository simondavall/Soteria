@page "/users/{UserId:guid}"

@using Microsoft.AspNetCore.Authorization

@attribute [Authorize]

<PageTitle>User Details</PageTitle>

<div class="user-details-page">
    <MudStack Spacing="4">
        <header class="user-details-page__header">
            <MudStack Row="true"
                      AlignItems="AlignItems.Center"
                      Justify="Justify.SpaceBetween"
                      Spacing="3"
                      Class="user-details-page__header-content">

                <MudStack Row="true"
                          AlignItems="AlignItems.Center"
                          Spacing="2">

                    <MudAvatar Color="Color.Primary"
                               Variant="Variant.Filled"
                               Size="Size.Large">
                        <MudIcon Icon="@Icons.Material.Filled.Person"/>
                    </MudAvatar>

                    <MudStack Spacing="0">
                        <MudText Typo="Typo.h4"
                                 HtmlTag="h1">
                            User Details
                        </MudText>

                        <MudText Typo="Typo.body1"
                                 Color="Color.Secondary">
                            Review the selected user's account and profile information.
                        </MudText>
                    </MudStack>
                </MudStack>

                <MudStack Row="true"
                          Spacing="2">

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Edit"
                               Disabled="true">
                        Edit
                    </MudButton>

                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.ArrowBack"
                               OnClick="ReturnToUserList">
                        Back to users
                    </MudButton>
                </MudStack>
            </MudStack>
        </header>

        @if (IsLoading)
        {
            <MudPaper Class="user-details-page__content"
                      Elevation="1">

                <div class="user-details-page__state">
                    <MudProgressCircular Indeterminate="true"
                                         Color="Color.Primary"/>

                    <MudText Typo="Typo.body1"
                             Color="Color.Secondary">
                        Loading user details...
                    </MudText>
                </div>
            </MudPaper>
        }
        else if (User is null)
        {
            <MudPaper Class="user-details-page__content"
                      Elevation="1">

                <div class="user-details-page__state">
                    <MudIcon Icon="@Icons.Material.Filled.PersonOff"
                             Size="Size.Large"
                             Color="Color.Secondary"/>

                    <MudText Typo="Typo.h5"
                             HtmlTag="h2">
                        User not found
                    </MudText>

                    <MudText Typo="Typo.body1"
                             Color="Color.Secondary"
                             Align="Align.Center">
                        The requested user does not exist or is no longer available.
                    </MudText>

                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.ArrowBack"
                               OnClick="ReturnToUserList">
                        Back to users
                    </MudButton>
                </div>
            </MudPaper>
        }
        else
        {
            <MudStack Spacing="4">
                <MudPaper Class="user-details-page__content"
                          Elevation="1">

                    <MudStack Spacing="3">
                        <MudText Typo="Typo.h6"
                                 HtmlTag="h2">
                            User Details
                        </MudText>

                        <div class="user-details-page__columns">
                            <div class="user-details-page__column">
                                <div class="user-details-page__field">
                                    <MudText Typo="Typo.overline"
                                             Color="Color.Secondary">
                                        User ID
                                    </MudText>

                                    <MudText Typo="Typo.body1">
                                        @User.UserId
                                    </MudText>
                                </div>

                                <div class="user-details-page__field">
                                    <MudText Typo="Typo.overline"
                                             Color="Color.Secondary">
                                        Username
                                    </MudText>

                                    <MudText Typo="Typo.body1">
                                        @User.UserName
                                    </MudText>
                                </div>

                                <div class="user-details-page__field">
                                    <MudText Typo="Typo.overline"
                                             Color="Color.Secondary">
                                        Display Name
                                    </MudText>

                                    <MudText Typo="Typo.body1">
                                        @User.DisplayName
                                    </MudText>
                                </div>

                                <div class="user-details-page__field">
                                    <MudText Typo="Typo.overline"
                                             Color="Color.Secondary">
                                        Email
                                    </MudText>

                                    <MudText Typo="Typo.body1">
                                        @User.Email
                                    </MudText>
                                </div>
                            </div>

                            <div class="user-details-page__column">
                                <div class="user-details-page__field">
                                    <MudText Typo="Typo.overline"
                                             Color="Color.Secondary">
                                        Email Confirmed
                                    </MudText>

                                    <MudChip T="bool"
                                             Color="@(User.EmailConfirmed ? Color.Success : Color.Warning)"
                                             Variant="Variant.Filled">
                                        @User.EmailConfirmed
                                    </MudChip>
                                </div>

                                <div class="user-details-page__field">
                                    <MudText Typo="Typo.overline"
                                             Color="Color.Secondary">
                                        Locked Out
                                    </MudText>

                                    <MudChip T="bool"
                                             Color="@(User.IsLockedOut ? Color.Error : Color.Success)"
                                             Variant="Variant.Filled">
                                        @User.IsLockedOut
                                    </MudChip>
                                </div>

                                <div class="user-details-page__field">
                                    <MudText Typo="Typo.overline"
                                             Color="Color.Secondary">
                                        Lockout End
                                    </MudText>

                                    <MudText Typo="Typo.body1">
                                        @FormatLockoutEnd(User.LockoutEnd)
                                    </MudText>
                                </div>
                            </div>
                        </div>
                    </MudStack>
                </MudPaper>

                <MudPaper Class="user-details-page__content"
                          Elevation="1">

                    <MudStack Spacing="3">
                        <MudText Typo="Typo.h6"
                                 HtmlTag="h2">
                            Permissions
                        </MudText>

                        <MudText Typo="Typo.body2"
                                 Color="Color.Secondary">
                            Client assignments, roles and permissions will be displayed here.
                        </MudText>
                    </MudStack>
                </MudPaper>
            </MudStack>
        }
    </MudStack>
</div>
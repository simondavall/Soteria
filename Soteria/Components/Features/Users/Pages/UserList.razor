@page "/users"

@using Microsoft.AspNetCore.Authorization
@using Soteria.Components.Features.Authorization

@attribute [Authorize(Policy = SoteriaAuthorizationPolicies.Administration)]

<PageTitle>Users</PageTitle>

<div class="users-page">
    <MudStack Spacing="4">
        <header class="users-page__header">
            <MudStack Row="true"
                      AlignItems="AlignItems.Center"
                      Justify="Justify.SpaceBetween"
                      Spacing="3"
                      Class="users-page__header-content">

                <MudStack Row="true"
                          AlignItems="AlignItems.Center"
                          Spacing="2">

                    <MudAvatar Color="Color.Primary"
                               Variant="Variant.Filled"
                               Size="Size.Large">
                        <MudIcon Icon="@Icons.Material.Filled.ManageAccounts"/>
                    </MudAvatar>

                    <MudStack Spacing="0">
                        <MudText Typo="Typo.h4"
                                 HtmlTag="h1">
                            Users
                        </MudText>

                        <MudText Typo="Typo.body1"
                                 Color="Color.Secondary">
                            Manage users registered with Soteria.
                        </MudText>
                    </MudStack>
                </MudStack>

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.PersonAdd"
                           OnClick="@CreateUserAsync">
                    Create user
                </MudButton>
            </MudStack>
        </header>

        <MudPaper Class="users-page__content">
            <MudTextField T="string"
                          @bind-Value="_searchText"
                          Label="Search users"
                          Placeholder="Search by username, display name, email or status"
                          Variant="Variant.Outlined"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Immediate="true"
                          Clearable="true"/>

            <MudTable T="UserSummary"
                      Items="Users"
                      Filter="FilterUser"
                      Hover="true"
                      Dense="true"
                      OnRowClick="SelectUser">

                <HeaderContent>
                    <MudTh>Username</MudTh>
                    <MudTh>Display Name</MudTh>
                    <MudTh>Email</MudTh>
                    <MudTh>Email Confirmed</MudTh>
                    <MudTh>Locked Out</MudTh>
                </HeaderContent>

                <RowTemplate>
                    <MudTd DataLabel="Username">
                        @context.UserName
                    </MudTd>

                    <MudTd DataLabel="Display Name">
                        @context.DisplayName
                    </MudTd>

                    <MudTd DataLabel="Email">
                        @context.Email
                    </MudTd>

                    <MudTd DataLabel="Email Confirmed">
                        <MudChip T="bool"
                                 Color="@(context.EmailConfirmed ? Color.Success : Color.Warning)"
                                 Variant="Variant.Filled">
                            @context.EmailConfirmed
                        </MudChip>
                    </MudTd>

                    <MudTd DataLabel="Locked Out">
                        <MudChip T="bool"
                                 Color="@(context.IsLockedOut ? Color.Error : Color.Success)"
                                 Variant="Variant.Filled">
                            @context.IsLockedOut
                        </MudChip>
                    </MudTd>
                </RowTemplate>

                <NoRecordsContent>
                    <MudStack Class="users-page__empty-state"
                              AlignItems="AlignItems.Center"
                              Justify="Justify.Center"
                              Spacing="3">

                        <MudIcon Icon="@Icons.Material.Filled.ManageAccounts"
                                 Size="Size.Large"/>

                        <MudText Typo="Typo.h5">
                            No users
                        </MudText>

                        <MudText Class="users-page__empty-description"
                                 Align="Align.Center">
                            No registered users match the current search.
                        </MudText>
                    </MudStack>
                </NoRecordsContent>
            </MudTable>
        </MudPaper>
    </MudStack>
</div>